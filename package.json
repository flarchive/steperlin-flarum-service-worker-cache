{
  "name": "flarum-service-worker-cache",
  "description": "Flarum extension for intelligent caching using Service Workers",
  "version": "1.1.1",
  "private": true,
  "scripts": {
    "dev": "echo 'Development environment ready'",
    "build": "echo 'No build process required for this PHP extension'",
    "test": "echo 'Running tests...'",
    "lint": "echo 'Running linters...'",
    "format": "prettier --write 'js/**/*.js' 'service-worker.js'",
    "validate": "composer validate --no-check-all --strict",
    "release": "npm run validate && git tag v$npm_package_version && git push --tags"
  },
  "keywords": [
    "flarum",
    "extension",
    "cache",
    "service-worker",
    "performance",
    "pwa"
  ],
  "author": "Steper Lin <steper.lin@icloud.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/linkerlin/flarum-service-worker-cache.git"
  },
  "bugs": {
    "url": "https://github.com/linkerlin/flarum-service-worker-cache/issues"
  },
  "homepage": "https://github.com/linkerlin/flarum-service-worker-cache#readme",
  "devDependencies": {
    "prettier": "^3.0.0"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}